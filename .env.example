# Variables de entorno — copiar a .env y completar con valores reales
# .env NUNCA se versiona (ver .gitignore)

# ── Bases de datos ──────────────────────────────────────────
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION

DB_HOST_SEDE1=pg_sede1
DB_PORT_SEDE1=5433
DB_NAME_SEDE1=clinica_sincelejo

DB_HOST_SEDE2=pg_sede2
DB_PORT_SEDE2=5434
DB_NAME_SEDE2=clinica_cartagena

DB_HOST_SEDE3=pg_sede3
DB_PORT_SEDE3=5435
DB_NAME_SEDE3=clinica_corozal

# ── HAPI FHIR ───────────────────────────────────────────────
HAPI_FHIR_URL=http://hapi-fhir:8090/fhir

# ── Seguridad (Fase 4) ──────────────────────────────────────
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_256_BITS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=clinica
KEYCLOAK_CLIENT_ID=plataforma-clinica
KEYCLOAK_CLIENT_SECRET=CAMBIAR_EN_PRODUCCION

# ── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── HSB ─────────────────────────────────────────────────────
HSB_HOST=0.0.0.0
HSB_PORT=8001
HSB_MAX_RETRIES=4
HSB_RETRY_BASE_SECONDS=1

