# Variables de entorno — copiar a .env:   cp .env.example .env
# .env NUNCA se versiona (ver .gitignore). Todos los datos de la plataforma son sintéticos.

# ── Credenciales de las bases (PostgreSQL y MongoDB usan las mismas) ────────
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=clinica_pass_2026

# ── Sedes: motor heterogéneo por sede ──────────────────────────────────────
#   Sede 1 Sincelejo = PostgreSQL · Sede 2 Cartagena = MongoDB · Sede 3 Corozal = PostgreSQL
DB_NAME_SEDE1=clinica_sincelejo
DB_NAME_SEDE2=clinica_cartagena
DB_NAME_SEDE3=clinica_corozal

# Puertos publicados en el equipo anfitrión (cámbielos si ya están ocupados)
DB_PORT_SEDE1=5433
MONGO_PORT_SEDE2=27018
DB_PORT_SEDE3=5435
DB_PORT_CENTRAL=5436
HAPI_PORT=8090
HSB_PORT=8001
API_PORT=8000

# ── Seguridad (Fase 4) ─────────────────────────────────────────────────────
# Genere uno propio:  openssl rand -hex 32
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_256_BITS

# ── HSB: reintentos con espera creciente (base * 2^(n-1)) ──────────────────
HSB_MAX_RETRIES=7
HSB_RETRY_BASE_SECONDS=2
