# Variables de entorno — copiar a .env:   cp .env.example .env
# .env NUNCA se versiona (ver .gitignore). Todos los datos de la plataforma son sintéticos.

# ── Credenciales de las bases (PostgreSQL y MongoDB usan las mismas) ────────
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=clinica_pass_2026

# ── Sedes: motor heterogéneo por sede ──────────────────────────────────────
#   Sede 1 Sincelejo = PostgreSQL · Sede 2 Cartagena = MongoDB · Sede 3 Corozal = PostgreSQL
DB_NAME_SEDE1=clinica_sincelejo
DB_NAME_SEDE2=clinica_cartagena
DB_NAME_SEDE3=clinica_corozal

# Puertos publicados en el equipo anfitrión (cámbielos si ya están ocupados).
# Las bases NO publican puertos: viven en la red interna red_datos. HAPI solo en 127.0.0.1.
HAPI_PORT=8090
HSB_PORT=8001
API_PORT=8000

# ── Seguridad (v3) ─────────────────────────────────────────────────────────
# desplegar.sh reemplaza las contraseñas de los roles por valores aleatorios al crear el .env.
# Roles de mínimo privilegio en las bases (uno por servicio)
HSB_DB_PASSWORD=hsb_pass_2026
API_DB_PASSWORD=api_pass_2026
API_CENTRAL_DB_PASSWORD=api_central_pass_2026
HAPI_DB_PASSWORD=hapi_pass_2026
HAPI_KEYSTORE_PASSWORD=hapi_keystore_2026
# IPs extra para los certificados (p. ej. la del PC si la VM está en NAT con reenvío de puertos)
CERT_IPS_EXTRA=

# OAuth 2.0: secretos de los clientes registrados (credenciales de PRUEBA, documentadas)
OAUTH_ISSUER=https://api:8000
OAUTH_SECRETO_PORTAL=portal_web_secreto_2026
OAUTH_SECRETO_API=api_gateway_secreto_2026
OAUTH_SECRETO_SEDE1=sede1_secreto_2026
OAUTH_SECRETO_SEDE2=sede2_secreto_2026
OAUTH_SECRETO_SEDE3=sede3_secreto_2026
OAUTH_SECRETO_QA=qa_secreto_2026

# ── HSB: reintentos con espera creciente (base * 2^(n-1)) ──────────────────
HSB_MAX_RETRIES=7
HSB_RETRY_BASE_SECONDS=2
